<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8"/>
		<link rel="stylesheet" href="bulma.min.css">
		<script defer src="https://use.fontawesome.com/releases/v5.3.1/js/all.js"></script>
	</head>
	<body>
		<section class="section">
			<div class="maincolumns columns is-desktop is-vcentered">
				<div class="column is-10 is-offset-1 notification is-info is-light box container">
					<div class="title">
						Users
					</div>

					<% if (locals.allUsers) { %>
						<div class="table-container">
							<table class="table is-bordered is-hoverable is-striped is-narrow">
								<thead>
									<tr>
										<th>First Name</th>
										<th>Last Name</th>
										<th>Email</th>
										<th>&nbsp;</th>
										<th>&nbsp;</th>
										<th>&nbsp;</th>
										<th>&nbsp;</th>
									</tr>
								</thead>

								<% let i = 0; %>
								<% for (i = 0; i < allUsers.length; i++) { %>
									<tr>
										<td><%= allUsers[i].first_name %></td>
										<td><%= allUsers[i].last_name %></td>
										<td><%= allUsers[i].email %></td>

										<td>
											<a href="/deleteUser?id=<%= allUsers[i].user_id %>">
												<span class="icon is-small">
													<i class="fas fa-user-times"></i>
												</span>
											</a>
										</td>

										<td>
											<a href="/showPets?id=<%= allUsers[i].user_id %>">
												<span class="icon is-small">
													<i class="fas fa-paw"></i>
												</span>
											</a>
										</td>

										<% if (allUsers[i].image_id) { %>
											<td>
												<img
													src="https://res.cloudinary.com/<%= cloud_name %>/image/upload/<%= allUsers[i].image_id %>"
													alt="user image"
													style="max-width: 100px; max-height: 100px;"
												>
											</td>
											<td>
												<a href="/deleteUserImage?id=<%= allUsers[i].user_id %>">
													<span class="icon is-small">
														<i class="fas fa-eraser"></i>
													</span>
												</a>
											</td>
										<% } else { %>
											<td colspan="2">
												<form action="/setUserPic" method="post" enctype="multipart/form-data">
													<input type="hidden" name="user_id" value="<%= allUsers[i].user_id %>"/>

													<div class="is-flex is-align-items-center" style="gap: 10px;">
														<div class="file is-info has-name is-small">
															<label class="file-label">
																<input class="file-input" type="file" name="image">
																<span class="file-cta">
																	<span class="file-icon">
																		<i class="fas fa-upload"></i>
																	</span>
																	<span class="file-label">Choose a file…</span>
																</span>
																<span class="file-name">No File</span>
															</label>
														</div>

														<button class="button is-link is-small" type="submit">
															<span>Upload</span>
															<span class="icon is-small">
																<i class="fas fa-image"></i>
															</span>
														</button>
													</div>
												</form>
											</td>
										<% } %>
									</tr>
								<% } %>

								<tfoot>
									<tr>
										<td colspan="7">
											There are <%= i %> users.
										</td>
									</tr>
								</tfoot>
							</table>
						</div>
					<% } %>

					<form action="addUser" method="post">
						<div class="field is-horizontal">
							<div class="field-label is-normal">
								<label class="label">Add New User</label>
							</div>
							<div class="field-body">
								<div class="field">
									<p class="control is-expanded">
										<input name="first_name" class="input" type="text" placeholder="First Name">
									</p>
								</div>
								<div class="field">
									<p class="control is-expanded">
										<input name="last_name" class="input" type="text" placeholder="Last Name">
									</p>
								</div>
								<div class="field">
									<p class="control is-expanded">
										<input name="email" class="input" type="email" placeholder="Email">
									</p>
								</div>
								<div class="field">
									<p class="control is-expanded">
										<input name="password" class="input" type="password" placeholder="Password">
									</p>
								</div>
								<div class="field">
									<button class="button is-link" type="submit">
										<span>Add</span>
										<span class="icon is-small">
											<i class="fas fa-user-plus"></i>
										</span>
									</button>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</section>

		<script>
			document.querySelectorAll('.file-input').forEach((input) => {
				input.addEventListener('change', () => {
					const fileBox = input.closest('.file');
					const fileName = fileBox.querySelector('.file-name');

					if (input.files.length > 0) {
						fileName.textContent = input.files[0].name;
					} else {
						fileName.textContent = 'No File';
					}
				});
			});
		</script>
	</body>
</html>